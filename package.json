{
  "name": "discogenius-root",
  "private": true,
  "workspaces": [
    "api",
    "app"
  ],
  "scripts": {
    "dev": "concurrently \"yarn --cwd api dev\" \"yarn --cwd app dev\" --names \"backend,frontend\" --prefix-colors \"magenta,cyan\"",
    "dev:all": "yarn dev",
    "build": "concurrently \"yarn --cwd api build\" \"yarn --cwd app build\"",
    "typecheck": "concurrently \"yarn --cwd api build\" \"yarn --cwd app typecheck\" --names \"api,app\" --prefix-colors \"magenta,cyan\"",
    "lint": "eslint .",
    "test": "yarn test:api && yarn test:app",
    "test:api": "yarn --cwd api test",
    "test:app": "yarn --cwd app test",
    "app:dev": "yarn --cwd app dev",
    "api:dev": "yarn --cwd api dev",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:smoke": "playwright test -c e2e/playwright.config.ts e2e/tests/navigation.spec.ts e2e/tests/auth.spec.ts",
    "test:e2e:headed": "playwright test -c e2e/playwright.config.ts --headed",
    "ci": "yarn lint && yarn typecheck && yarn test:api && yarn test:app && yarn build",
    "release:prepare": "node .github/workflows/release/prepare-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "axe-core": "^4.13.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "body-parser": "1.20.6",
    "path-to-regexp": "0.1.13",
    "qs": "6.15.2"
  },
  "packageManager": "yarn@1.22.22"
}
