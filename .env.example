# Optional app password for the dashboard login gate. Leave blank to disable it.
ADMIN_PASSWORD=

# Secret used to sign session and stream tokens. When left blank, the server
# generates one and persists it to /config/jwt_secret. Set it explicitly only
# to pin a fixed secret or share it across instances.
JWT_SECRET=

# Backend/runtime port (API + bundled frontend in Docker/production).
# Vite dev server stays on 8080.
PORT=3737

# Network interface the backend binds to. Direct non-Docker runs default to
# loopback. Compose explicitly binds inside its container to make port
# publishing work.
# DISCOGENIUS_BIND_IP=127.0.0.1

# Comma-separated cross-origin browser origins. Same-origin requests need no
# entry. Leave blank unless the frontend is deliberately hosted elsewhere.
# DISCOGENIUS_CORS_ORIGINS=https://music.example.com

# Docker Compose uses PORT for both the in-container listener and published host port.
# Change PORT above if you want Docker to run on a different port.
# Compose publishes on loopback by default. Set BIND_ADDRESS=0.0.0.0 only when
# LAN access is intended, and configure ADMIN_PASSWORD before exposing it.
# BIND_ADDRESS=127.0.0.1

# Optional frontend API override.
# Local dev (`yarn dev`) ignores VITE_API_URL and uses same-origin + Vite proxy.
# Use this only for production builds or advanced cross-origin setups.
# VITE_API_URL=http://localhost:3737

# Optional backend worker tuning
# Docker Compose enables automatic monitoring and scheduled jobs by default.
# Set either variable to 1 only when you deliberately want to pause that worker.
# DISCOGENIUS_DISABLE_MONITORING=0
# DISCOGENIUS_DISABLE_SCHEDULER=0
# DISCOGENIUS_DOWNLOAD_TIMEOUT_MS=7200000
# DISCOGENIUS_DOWNLOAD_IDLE_TIMEOUT_MS=600000
# DISCOGENIUS_DOWNLOAD_POLL_MS=2000
# DISCOGENIUS_SCHEDULER_POLL_MS=2000
# Number of job worker threads for the command queue. Queued commands and the
# heavy ImportDownload step always run on these worker threads so scans/imports
# never freeze the API + UI. See docs/JOB_EXECUTION_THREADING_PLAN.md.
# DISCOGENIUS_SCHEDULER_THREAD_LIMIT=3

# Log any main-thread DB read that blocks the event loop longer than this many
# ms (0 = off). Diagnostic for UI sluggishness under load; cheap to leave on.
# DISCOGENIUS_READ_PROFILE_MS=0

# Optional catalog source override. Factory default (when unset) is online
# Servarr Metadata (`servarr` / `servarr-metadata`). This env var wins over the
# Settings UI and over a wiped config/DB — omit it unless you intentionally
# force a catalog mode for the whole deploy.
# DISCOGENIUS_CATALOG_SOURCE=servarr-metadata
# For local MusicBrainz-docker (see docs/MB_LOCAL_MODE.md):
# DISCOGENIUS_CATALOG_SOURCE=musicbrainz-local
# MB_LOCAL_HOST=localhost
